# Base URL of the DRF API. /api uses the Vite dev proxy; use an absolute
# URL such as http://localhost:8000/api when calling Django directly.
VITE_API_URL=/api

# Stripe publishable key (pk_test_...). Required to render the card form.
# The matching secret key belongs in the Django .env as STRIPE_SECRET_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=
