# Django / DRF
# CORS origins for the Vite dev server (comma separated, no spaces).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Stripe (optional). Without these the API returns 503 for card intents and
# the React payment page offers the pay-on-delivery order path instead.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# AI listing assistant (optional). Leave AI_PROVIDER/AI_API_KEY blank to use
# the built-in local draft and image fallback. Supported providers: openai,
# openrouter, gemini. AI_BASE_URL is optional for OpenAI-compatible gateways.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Optional image model (OpenAI-compatible image generation). When blank, a
# local preview is generated under MEDIA_ROOT/ai-listings/ and saved with the draft.
AI_IMAGE_MODEL=
AI_TIMEOUT_SECONDS=15
# Optional: run bulk uploads in a background thread instead of synchronously
AI_BULK_ASYNC=0
